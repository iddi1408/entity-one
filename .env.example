# Set these as temporary secret runtime values in Sites for the initial deployment.
# Remove them after the first verified admin login, then redeploy the saved version.
ADMIN_INITIAL_USERNAME=
ADMIN_INITIAL_PASSWORD=

# Hosted audit notifications; set only as a secret in Sites, never commit a value.
DISCORD_AUDIT_WEBHOOK_URL=

# Claude concierge; configure as a secret in Sites, never commit a value.
ANTHROPIC_API_KEY=

# Contact form: create a free Web3Forms form for sales@entity-1.com and verify
# that mailbox, then add its UUID form access key as a Sites runtime value.
# This is a PUBLIC form identifier returned by /api/contact/config, not a secret.
# Visitors submit directly to Web3Forms; the free plan does not allow server proxies.
# Never place a mailbox password, SMTP credential or other API secret here.
WEB3FORMS_ACCESS_KEY=
