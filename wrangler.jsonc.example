{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "entity-one-brokerage",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/content.json", "/assets/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "entity-one-db",
      "database_id": "SET_AFTER_CREATING_D1",
      "migrations_dir": "./drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "SET_AFTER_CREATING_KV"
    }
  ],
  "observability": {"enabled": true}
}
